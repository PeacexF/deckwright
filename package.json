{
  "name": "claude-deck",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Code plugin: researched, verified presentations as editable PPTX",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "node --test \"tests/e2e/*.test.mjs\"",
    "validate": "claude plugin validate --strict ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "fontkit": "^2.0.4",
    "jszip": "^3.10.2",
    "pptx-automizer": "^0.9.4",
    "pptxgenjs": "^4.0.1",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "image-size": "^2.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
